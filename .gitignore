# =============================================================================
# WSO2 Deployment — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------

# Exception: public CA cert used for TLS verification in helm confs
# If you need to track wso2.crt specifically, uncomment the next line:
# !**/confs/wso2.crt

# -----------------------------------------------------------------------------
# Secrets and credentials
# -----------------------------------------------------------------------------
# Helm values files with real passwords/keys — use values.yaml only as a template
# Commit a values.example.yaml or default_values.yaml with placeholders instead
# Re-allow default/example values files (no real secrets)
!**/default_values.yaml
!**/default_openshift_values.yaml
!**/values_full.yaml
!**/values_local.yaml

# Secret conf files (may contain encrypted/plaintext passwords)
**/secret-conf.properties

# Auth tokens (e.g. MI Dashboard auth.json)
**/auth.json

# Docker registry credentials
**/.dockerconfigjson
**/docker-config.json

# Cloud provider credential files
**/*.credentials
**/*.kubeconfig
**/kubeconfig
**/.aws/
**/.azure/

# -----------------------------------------------------------------------------
# Helm — generated and local artifacts
# -----------------------------------------------------------------------------
# Rendered manifests (generated output, not source)
**/rendered.yaml

# Helm chart lock and dependency cache
**/Chart.lock
**/charts/

# Helm debug output
*.helm.debug

# -----------------------------------------------------------------------------
# Java / WSO2 build artifacts
# -----------------------------------------------------------------------------
*.class
*.jar
*.war
*.nar
*.ear

# Exception: track JDBC drivers and custom libs that are part of the Docker build
!apim-deployment/apim/lib/*.jar
!mi-deployment/agency-intg/libs/*.jar

# -----------------------------------------------------------------------------
# Archives
# -----------------------------------------------------------------------------
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z

# -----------------------------------------------------------------------------
# Logs and runtime files
# -----------------------------------------------------------------------------
*.log
*.log.*
logs/
hs_err_pid*
replay_pid*

# WSO2 runtime directories (if repo ever sits inside a WSO2 server home)
repository/logs/
repository/deployment/server/
tmp/
work/

# -----------------------------------------------------------------------------
# OS and editor artifacts
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Java/Mobile legacy (kept from original)
# -----------------------------------------------------------------------------
*.ctxt
.mtj.tmp/