pipeline {
    agent any

    options {
        skipDefaultCheckout()
    }

    environment {
        // Username/password credential in Jenkins for the container registry
        REGISTRY_CREDENTIALS = 'docker-registry'
        
        // Artifactory configuration
        ARTIFACTORY_SERVER_ID = 'artifactory-server'
        ARTIFACTORY_DOCKER_CREDS = 'artifactory-docker'
        ARTIFACTORY_URL = 'http://100.117.18.88:8082'
        ARTIFACTORY_DOCKER_REPO = 'wso2-apim-docker-local'
        ARTIFACTORY_HELM_REPO = 'wso2-apim-helm-local'
        ARTIFACTORY_GENERIC_REPO = 'wso2-apim-generic-local'
        ARTIFACTORY_DOCKER_REGISTRY = '100.117.18.88:8082'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Find Dockerfile') {
            steps {
                script {
                    env.DOCKERFILE = sh(
                        script: '''
                            set -e
                            FILE=$(find . -type d -name mi-deployment -prune -o -name Dockerfile -print | head -n 1)
                            if [ -z "$FILE" ]; then
                                echo "No Dockerfile found" >&2
                                exit 1
                            fi
                            echo "$FILE"
                        ''',
                        returnStdout: true
                    ).trim()
                    env.DOCKER_DIR = env.DOCKERFILE.replaceAll('/Dockerfile$', '')
                    env.VALUES_FILE = "${env.DOCKER_DIR}/../helm-apim/all-in-one/values.yaml"
                    echo "Dockerfile: ${env.DOCKERFILE}"
                    echo "Build context: ${env.DOCKER_DIR}"
                    echo "Helm values: ${env.VALUES_FILE}"
                }
            }
        }

        stage('Build and Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.REGISTRY_CREDENTIALS,
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        set -e
                        REGISTRY=$(grep -E '^[[:space:]]+registry:' "$VALUES_FILE" | head -n 1 | cut -d'"' -f2)
                        REPOSITORY=$(grep -E '^[[:space:]]+repository:' "$VALUES_FILE" | head -n 1 | cut -d'"' -f2)
                        IMAGE="${REGISTRY}/${REPOSITORY}"
                        TAG="1.$(printf '%02d' "${BUILD_NUMBER}")"

                        echo "$DOCKER_PASS" | docker login "$REGISTRY" -u "$DOCKER_USER" --password-stdin

                        # Pull previous latest for layer caching (failure is non-fatal on first run)
                        docker pull "${IMAGE}:latest" || true

                        # Build with BuildKit and inline cache — reuses layers from previous build
                        DOCKER_BUILDKIT=1 docker build \
                            --cache-from "${IMAGE}:latest" \
                            --build-arg BUILDKIT_INLINE_CACHE=1 \
                            -t "${IMAGE}:${TAG}" \
                            -t "${IMAGE}:latest" \
                            -f "${DOCKERFILE}" "${DOCKER_DIR}"

                        docker push "${IMAGE}:${TAG}"
                        docker push "${IMAGE}:latest"

                        # Get digest from local image — no need to re-pull
                        DIGEST=$(docker inspect --format='{{index .RepoDigests 0}}' "${IMAGE}:${TAG}" | cut -d@ -f2)

                        echo "${IMAGE}" > .ci-image
                        echo "${TAG}" > .ci-tag
                        echo "${DIGEST}" > .ci-digest
                    '''
                }
            }
        }

        stage('Publish to Artifactory') {
            steps {
                script {
                    def server = Artifactory.server env.ARTIFACTORY_SERVER_ID
                    def TAG = sh(script: 'cat .ci-tag', returnStdout: true).trim()
                    
                    // 1. Push Docker image to Artifactory
                    withCredentials([usernamePassword(
                        credentialsId: env.ARTIFACTORY_DOCKER_CREDS,
                        usernameVariable: 'ART_USER',
                        passwordVariable: 'ART_PASS'
                    )]) {
                        sh """
                            set -e
                            IMAGE=\$(cat .ci-image)
                            
                            # Login to Artifactory Docker registry
                            echo "\$ART_PASS" | docker login ${env.ARTIFACTORY_DOCKER_REGISTRY} -u "\$ART_USER" --password-stdin
                            
                            # Tag for Artifactory
                            docker tag "\${IMAGE}:${TAG}" "${env.ARTIFACTORY_DOCKER_REGISTRY}/${env.ARTIFACTORY_DOCKER_REPO}/wso2am-custom:${TAG}"
                            docker tag "\${IMAGE}:${TAG}" "${env.ARTIFACTORY_DOCKER_REGISTRY}/${env.ARTIFACTORY_DOCKER_REPO}/wso2am-custom:latest"
                            
                            # Push to Artifactory
                            docker push "${env.ARTIFACTORY_DOCKER_REGISTRY}/${env.ARTIFACTORY_DOCKER_REPO}/wso2am-custom:${TAG}"
                            docker push "${env.ARTIFACTORY_DOCKER_REGISTRY}/${env.ARTIFACTORY_DOCKER_REPO}/wso2am-custom:latest"
                        """
                    }
                    
                    // 2. Package and push Helm chart
                    sh """
                        set -e
                        cd "${env.DOCKER_DIR}/../helm-apim/all-in-one"
                        
                        # Update Chart.yaml version to match build tag
                        sed -i "s|^version:.*|version: ${TAG}|" Chart.yaml
                        
                        # Package the chart
                        helm package .
                        
                        CHART_FILE=\$(ls wso2am-all-in-one-*.tgz | head -n 1)
                        echo "Packaged chart: \${CHART_FILE}"
                        
                        # Upload to Artifactory using curl
                        curl -u "\${ART_USER}:\${ART_PASS}" \
                            -T "\${CHART_FILE}" \
                            "${env.ARTIFACTORY_URL}/artifactory/${env.ARTIFACTORY_HELM_REPO}/\${CHART_FILE}"
                    """
                    
                    // 3. Upload DB scripts to Artifactory
                    withCredentials([usernamePassword(
                        credentialsId: env.ARTIFACTORY_DOCKER_CREDS,
                        usernameVariable: 'ART_USER',
                        passwordVariable: 'ART_PASS'
                    )]) {
                        sh """
                            set -e
                            
                            # Upload apimgt DB script
                            curl -u "\${ART_USER}:\${ART_PASS}" \
                                -T "${env.DOCKER_DIR}/db-scripts/apimgt/mysql.sql" \
                                "${env.ARTIFACTORY_URL}/artifactory/${env.ARTIFACTORY_GENERIC_REPO}/wso2-apim/${TAG}/db-scripts/apimgt/mysql.sql"
                            
                            # Upload shareddb DB script
                            curl -u "\${ART_USER}:\${ART_PASS}" \
                                -T "${env.DOCKER_DIR}/db-scripts/shareddb/mysql.sql" \
                                "${env.ARTIFACTORY_URL}/artifactory/${env.ARTIFACTORY_GENERIC_REPO}/wso2-apim/${TAG}/db-scripts/shareddb/mysql.sql"
                            
                            echo "Successfully published all artifacts to Artifactory"
                        """
                    }
                    
                    // 4. Publish build info to Artifactory
                    def buildInfo = Artifactory.newBuildInfo()
                    buildInfo.name = "wso2-apim-build"
                    buildInfo.number = "${TAG}"
                    buildInfo.env.capture = true
                    server.publishBuildInfo buildInfo
                }
            }
        }

        stage('Update Helm values') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'Github-Access',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_PASS'
                )]) {
                    sh '''
                        set -e
                        TAG=$(cat .ci-tag)
                        DIGEST=$(cat .ci-digest)
                        cd "$(dirname "$VALUES_FILE")"
                        sed -i "s|tag: \\".*\\"|tag: \\"${TAG}\\"|" values.yaml
                        sed -i "s|digest: \\".*\\"|digest: \\"${DIGEST}\\"|" values.yaml

                        git config user.email "jenkins@ci"
                        git config user.name "Jenkins CI"
                        git add values.yaml
                        git commit -m "ci: update APIM image tag=${TAG} digest=${DIGEST}"

                        REMOTE_URL=$(git remote get-url origin)
                        AUTH_URL=$(echo "$REMOTE_URL" | sed "s|https://|https://${GIT_USER}:${GIT_PASS}@|")
                        BRANCH=$(echo "$GIT_BRANCH" | sed 's|origin/||')
                        git push "$AUTH_URL" HEAD:refs/heads/${BRANCH}
                    '''
                }
            }
        }
    }
}
